<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Allow network access for Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyAttendance">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyAttendance" />

        <activity
            android:name=".RoleSelectActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyAttendance">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login and dashboard activities -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/login_title"
            android:theme="@style/Theme.MyAttendance" />

        <activity
            android:name=".StudentDashboardActivity"
            android:exported="true"
            android:label="@string/student_dashboard"
            android:theme="@style/Theme.MyAttendance" />

        <activity
            android:name=".FacultyDashboardActivity"
            android:exported="true"
            android:label="@string/faculty_dashboard"
            android:theme="@style/Theme.MyAttendance" />

        <activity
            android:name=".AdminDashboardActivity"
            android:exported="true"
            android:label="@string/admin_dashboard"
            android:theme="@style/Theme.MyAttendance" />

        <activity
            android:name=".AddUserActivity"
            android:exported="true"
            android:label="Add User"
            android:theme="@style/Theme.MyAttendance" />

    </application>

</manifest>